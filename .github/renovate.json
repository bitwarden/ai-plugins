{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>bitwarden/renovate-config"],
  "enabledManagers": ["github-actions", "npm", "custom.jsonata"],
  "customManagers": [
    {
      "description": "Track the upstream branch of external Claude plugins pinned by commit in the marketplace manifest",
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/^\\.claude-plugin/marketplace\\.json$/"],
      "matchStrings": [
        "plugins[source.source = 'url'].{ 'depName': name, 'packageName': source.url, 'currentDigest': source.sha }"
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "groupName": "github-action minor",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "npm minor",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
