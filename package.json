{
  "name": "@bitwarden/ai-plugins",
  "version": "0.0.0",
  "description": "Bitwarden AI Plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitwarden/ai-plugins.git"
  },
  "author": "Bitwarden Inc. <hello@bitwarden.com> (https://bitwarden.com)",
  "license": "SEE LICENSE IN LICENSE.txt",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "bugs": {
    "url": "https://github.com/bitwarden/ai-plugins/issues"
  },
  "homepage": "https://bitwarden.com",
  "devDependencies": {
    "cspell": "10.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*": "prettier --cache --write --ignore-unknown"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm run lint:prettier && pnpm run lint:spelling",
    "lint:prettier": "prettier --check .",
    "lint:spelling": "cspell lint --no-progress --no-summary --gitignore '**'",
    "format": "prettier --write ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "error"
    }
  }
}
