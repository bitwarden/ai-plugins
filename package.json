{
  "name": "@bitwarden/ai-plugins",
  "version": "0.0.0",
  "description": "Bitwarden AI Plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitwarden/ai-plugins.git"
  },
  "author": "Bitwarden Inc. <hello@bitwarden.com> (https://bitwarden.com)",
  "license": "SEE LICENSE IN LICENSE.txt",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "bugs": {
    "url": "https://github.com/bitwarden/ai-plugins/issues"
  },
  "homepage": "https://bitwarden.com",
  "devDependencies": {
    "corepack": "0.36.0",
    "cspell": "10.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6"
  },
  "lint-staged": {
    "*": "prettier --cache --write --ignore-unknown"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm run lint:prettier && pnpm run lint:spelling && pnpm run lint:guardrail",
    "lint:prettier": "prettier --check .",
    "lint:spelling": "cspell lint --no-progress --no-summary --gitignore '**'",
    "lint:guardrail": "bash plugins/bitwarden-testing-tools/scripts/validate-guardrail.sh",
    "format": "prettier --write ."
  }
}
