{
  "profile": "bitwarden",
  "version": "1.4.0",
  "abacus": ">=0.21",
  "plugins": {
    "workers": [
      "bitwarden-delivery-tools",
      "bitwarden-code-review",
      "bitwarden-security-engineer",
      "bitwarden-software-engineer",
      "claude-config-validator",
      "plugin-dev"
    ],
    "planner": [
      "bitwarden-atlassian-tools",
      "bitwarden-code-review",
      "bitwarden-product-analyst"
    ],
    "concierge": [],
    "orchestrator": []
  },
  "slots": {
    "plan.source": "bitwarden-atlassian-tools:researching-jira-issues",
    "plan.analyze": "",
    "implement.guide": "",
    "review": {
      "standard": { "skill": "bitwarden-abacus-tools:standard-review" },
      "substantial": {
        "workflow": "bitwarden-abacus-tools:substantial-review"
      },
      "assess": "bitwarden-code-review:addressing-code-review-comments"
    },
    "assess-risk": "bitwarden-code-review:assessing-change-risk",
    "land.commit": "bitwarden-abacus-tools:commit-message",
    "land.pr": "bitwarden-abacus-tools:composing-abacus-pull-requests",
    "retro.analyze": ""
  }
}
