{
  "name": "@bitwarden/atlassian-tools-mcp",
  "version": "1.0.0",
  "description": "Jira MCP server for issue retrieval, JQL search, comments, project discovery, and opt-in issue creation/linking",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "bitwarden-atlassian-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "watch": "tsc --watch",
    "dev": "tsc && node build/index.js",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector@0.22.0 build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "jira",
    "model-context-protocol",
    "atlassian",
    "jql"
  ],
  "author": "Bitwarden",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "7.0.2",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.11.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "error"
    }
  }
}
