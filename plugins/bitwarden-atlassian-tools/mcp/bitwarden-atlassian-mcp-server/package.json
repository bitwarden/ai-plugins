{
  "name": "@bitwarden/atlassian-tools-mcp",
  "version": "1.0.0",
  "description": "Jira MCP server for issue retrieval, JQL search, comments, project discovery, and opt-in issue creation/linking",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "bitwarden-atlassian-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "watch": "tsc --watch",
    "dev": "tsc && node build/index.js",
    "inspector": "pnpm dlx @modelcontextprotocol/inspector@0.22.0 build/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "jira",
    "model-context-protocol",
    "atlassian",
    "jql"
  ],
  "author": "Bitwarden",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.3",
    "axios": "1.20.0",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
