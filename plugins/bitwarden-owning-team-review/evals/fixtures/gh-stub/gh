#!/usr/bin/env bash
# Stand-in for `gh` in classification-eval runs. Serves `gh pr view` and `gh pr diff` for one canned
# pull request from the directory in GH_STUB_DATA (pr.json, pr.diff, pr.files), and logs every
# invocation to calls.log there. It never calls the real gh: anything else exits 1.
set -euo pipefail

data="${GH_STUB_DATA:?GH_STUB_DATA is not set}"
printf '%s\n' "$*" >>"$data/calls.log"

fail() { echo "gh stub: $*" >&2; exit 1; }

[[ $# -ge 2 && "$1" == pr ]] || fail "unsupported command: gh $*"
cmd="$2"
shift 2
[[ "$cmd" == view || "$cmd" == diff ]] || fail "unsupported command: gh pr $cmd"

number="$(jq -r .number "$data/pr.json")"
url="$(jq -r .url "$data/pr.json")"

selector=""
fields=""
expr=""
name_only=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) fields="${2:?--json needs fields}"; shift 2 ;;
    --json=*) fields="${1#--json=}"; shift ;;
    -q|--jq) expr="${2:?--jq needs an expression}"; shift 2 ;;
    --jq=*) expr="${1#--jq=}"; shift ;;
    --name-only) name_only=true; shift ;;
    --patch|--color=*) shift ;;
    --color) shift 2 ;;
    -*) fail "unsupported flag: $1" ;;
    *) [[ -z "$selector" ]] || fail "unexpected argument: $1"; selector="$1"; shift ;;
  esac
done

case "$selector" in
  "$number" | "#$number" | "$url") ;;
  "") fail "no pull request found for the current branch" ;;
  *) fail "no pull requests found for $selector" ;;
esac

if [[ "$cmd" == diff ]]; then
  if $name_only; then cat "$data/pr.files"; else cat "$data/pr.diff"; fi
  exit 0
fi

if [[ -n "$fields" ]]; then
  json="$(jq -c --arg f "$fields" '($f | split(",")) as $k | with_entries(select(.key as $x | $k | index($x)))' "$data/pr.json")"
  if [[ -n "$expr" ]]; then jq -r "$expr" <<<"$json"; else jq . <<<"$json"; fi
  exit 0
fi

jq -r '"title:\t\(.title)\nstate:\t\(.state)\nauthor:\t\(.author.login)\nnumber:\t\(.number)\nurl:\t\(.url)\n--\n\(.body)"' "$data/pr.json"
